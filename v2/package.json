{
  "name": "roblox-cloud-controller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/contracts.test.mjs tests/token.test.mjs",
    "test:crypto": "node --experimental-strip-types --test tests/seal.test.mjs",
    "test:rules": "npx -y firebase-tools@15.34.2 emulators:exec --only database --project demo-noka-controller \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "13.2.0",
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
