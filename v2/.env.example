# Firebase web app config (Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roblox-cloud-farm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=roblox-cloud-farm
# Copy the exact URL from Realtime Database. Do not guess its region.
FIREBASE_DATABASE_URL=https://roblox-cloud-farm-default-rtdb.firebaseio.com
# No service-account private key is required. Dashboard access is granted by
# nokaController/v1/operators/<Firebase Auth UID> = true in Realtime Database.
